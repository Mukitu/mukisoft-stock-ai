# Protect server credentials and runtime quota store from direct HTTP access
<FilesMatch "^(config\.php|config\.example\.php|\.htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 403 (?i)/quota_store(/.*)?$
</IfModule>

Options -Indexes
